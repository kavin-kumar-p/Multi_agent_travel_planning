# ── LLM Provider ──────────────────────────────────────────────────────────────
# "gemini" | "anthropic" | "openai"
LLM_PROVIDER=gemini

# ── API Keys ──────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=AIza...          # required when LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=sk-ant-...    # required when LLM_PROVIDER=anthropic
OPENAI_API_KEY=sk-...           # required when LLM_PROVIDER=openai
                                # also used for embeddings with anthropic provider

# ── Model selection per agent ─────────────────────────────────────────────────
# Gemini defaults (change to claude-* or gpt-* when switching provider)
COORDINATOR_MODEL=gemini-3.1-flash-lite
FLIGHT_AGENT_MODEL=gemini-3.1-flash-lite
ATTRACTIONS_AGENT_MODEL=gemini-3.1-flash-lite
HOTEL_AGENT_MODEL=gemini-3.1-flash-lite
TRANSPORT_AGENT_MODEL=gemini-3.1-flash-lite

# ── Embeddings ────────────────────────────────────────────────────────────────
# gemini  → gemini-embedding-2-preview  (Google, no extra key)
# openai  → text-embedding-3-small      (requires OPENAI_API_KEY)
EMBEDDING_MODEL=gemini-embedding-2-preview

# ── RAG ───────────────────────────────────────────────────────────────────────
FAISS_INDEX_DIR=data/faiss
RAG_TOP_K=3
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Budget ────────────────────────────────────────────────────────────────────
DEFAULT_TOTAL_BUDGET=3000.0

# ── ADK Session Store ─────────────────────────────────────────────────────────
ADK_SESSION_DB_URL=sqlite:///data/sessions.db

# ── Agent Retry ───────────────────────────────────────────────────────────────
AGENT_MAX_RETRIES=3
